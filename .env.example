# npm start loads .env; copy this example and adjust locally.
PORT=4310
PREVIEW_PORT=4311
# Operator-only exact loopback exceptions for tests. NEVER accept from web request.
# FIXTURE_ORIGINS=http://127.0.0.1:9411,http://127.0.0.1:9412,http://127.0.0.1:9413,http://127.0.0.1:9414,http://127.0.0.1:9415
BROWSER_CHANNEL=chrome
# Provider settings alone do not enable AI: select a UI model or pass CLI --ai.
# AI_ENDPOINT=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5-coder:1.5b-instruct
# AI_API_KEY=
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
# AI_CACHED_INPUT_USD_PER_MILLION=
# COMPUTE_USD_PER_HOUR=
# CONSULTATION_URL=https://your-agency.example/consult
# AI_VISION=1

# AI Chat model-backed repair loop
# The migration server reads only PORT and API_AUTH_TOKEN from this local file.
# Never commit credentials. AI Chat keeps provider keys / ChatGPT sessions itself.
AI_CHAT_ENV_FILE=/absolute/path/to/ai-chat/.env
AI_CHAT_URL=http://127.0.0.1:4174
# Alternative to AI_CHAT_ENV_FILE: AI_CHAT_TOKEN=your-local-app-token
MIGRATION_AI_MODEL=gpt-6-astra
# Explicit test-only loopback exceptions; leave empty for public sites only.
FIXTURE_ORIGINS=

# Optional deeper post-build desktop/mobile Lighthouse audit (adds runtime).
# LIGHTHOUSE_AUDIT=1
