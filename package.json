{
  "name": "website-cloner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node scripts/server-control.mjs start",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "demo": "node scripts/evaluate.mjs",
    "migrate": "node scripts/migrate.mjs",
    "audit:site": "node scripts/audit.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "audit:showcase": "node scripts/showcase.mjs",
    "restart": "node scripts/server-control.mjs restart",
    "stop": "node scripts/server-control.mjs stop",
    "serve": "node --env-file-if-exists=.env app/server.mjs",
    "demo:setup": "python3 tests/fixtures/setup.py --site gutenberg --runtime work/launch-demo",
    "demo:source": "python3 tests/fixtures/serve.py --runtime work/launch-demo"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.2",
    "@discoveryjs/json-ext": "1.1.0",
    "cheerio": "1.1.2",
    "image-size": "2.0.4",
    "ipaddr.js": "2.2.0",
    "lighthouse": "13.5.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.31",
    "postcss-safe-parser": "7.1.0",
    "robots-parser": "3.0.1",
    "sanitize-html": "2.18.1",
    "turndown": "7.2.2",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kujolang/website-cloner.git"
  }
}
